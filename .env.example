# Base URL da API — DEVE incluir o prefixo /api/v1 (todos os routers de negócio vivem sob ele; só /health fica na raiz).
# Os paths dos services são relativos (/transactions, /cards, ...) — o /api/v1 vem da base.
# dev:       http://localhost:8000/api/v1
# produção:  https://api.hivvo.app/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# DSN do Sentry. AUSENTE = no-op: o SDK não inicializa e nada é enviado — deixe
# vazia em dev (erro de dev vai pro console, não pro Sentry).
# Setada no painel da Vercel para production/preview.
# environment e release NÃO se configuram aqui: saem do define do vite.config.ts
# (VERCEL_ENV e pkg.version+sha).
VITE_SENTRY_DSN=

# --- Upload de source map (só no build da Vercel; NÃO precisa em dev) ---
# Sem os três, o plugin do Sentry sai do build e nenhum mapa é enviado.
# O token é de build (server-side), nunca chega ao browser — não use prefixo VITE_.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
